# Xcode
*.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/

# Swift Package Manager
# (Packages/ holds our own local packages such as the Reality Composer Pro
# content, so it is tracked; Xcode checks dependencies out under DerivedData.)
.build/
.swiftpm/
Package.pins
Package.resolved

# CocoaPods (if ever used)
Pods/

# Secrets — NEVER commit real API keys
Ouest/Configuration/Debug.xcconfig
Ouest/Configuration/Release.xcconfig

# Environment
.env
.env.local
.env.production

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Thumbnails
Thumbs.db

# IDE
.idea/
.vscode/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Supabase
supabase/.branches
supabase/.temp

# Apple Push Notification private key — NEVER commit
APN key/

# Local build output + marketing assets
build/
app-store-screenshots/

# Agent/tooling scratch
.agents/
.claude/worktrees/
# Per-machine Claude Code permissions; records shell commands verbatim, so it can hold secrets
.claude/settings.local.json
